{
  "name": "lab-01-task-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Лабораторна 1: REST API системи керування завданнями",
  "engines": { "node": "^22.12.0 || ^24.0.0" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "docs:build": "node scripts/build-openapi.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js",
    "check": "npm run db:validate && npm run docs:build && npm test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "helmet": "8.1.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1",
    "supertest": "7.1.4"
  }
}
